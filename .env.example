# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a GitHub. En Vercel, pon estos mismos valores en
# Project Settings → Environment Variables.

# ── App ─────────────────────────────────────────────────────────────
# URL pública de la app (en producción, la de Vercel o tu dominio).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (fase 2) ───────────────────────────────────────────────
# supabase.com → tu proyecto → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "Publishable key" (empieza por sb_publishable_). Puede verse en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta "Secret key" (empieza por sb_secret_). SOLO servidor, nunca en el navegador.
SUPABASE_SECRET_KEY=

# ── IA de texto: Anthropic / Claude (fase 5) ────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── IA de imágenes (fase 6) ─────────────────────────────────────────
# Proveedor por definir; la app lo usa a través de un adaptador.
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=

# ── IA de video (fase 9) ────────────────────────────────────────────
VIDEO_AI_PROVIDER=
VIDEO_AI_API_KEY=

# ── Administrador (fase 4) ──────────────────────────────────────────
# Correos con acceso al panel de administrador, separados por coma.
ADMIN_EMAILS=
